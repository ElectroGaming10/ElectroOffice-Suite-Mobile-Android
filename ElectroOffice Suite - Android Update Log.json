                {
                    "type": "added",
                    "description": "Added online update information and changelog support."
                },
                {
                    "type": "added",
                    "description": "Added support for update channels: Release, Beta, Alpha, and Pre-Alpha."
                },
                {
                    "type": "added",
                    "description": "Added cumulative What's New support for displaying changelogs from missed updates."
                },
                {
                    "type": "added",
                    "description": "Added Android compatibility information for minimum, recommended, and target Android versions."
                },
                {
                    "type": "compatibility",
                    "description": "Added classic Android version codenames to compatibility information for supported legacy Android releases."
                },
                {
                    "type": "compatibility",
                    "description": "Changed update manifest fetching to use the GitHub REST API for improved compatibility with older Android devices."
                },
                {
                    "type": "bug-fixed",
                    "description": "Fixed update manifest fetching on Android 6.0.1 Marshmallow devices affected by certificate trust errors with the previous GitHub Raw endpoint."
                },
                {
                    "type": "security",
                    "description": "Update checks continue to require valid HTTPS certificate verification without bypassing certificate security."
                },
                {
                    "type": "improved",
                    "description": "Improved update connection error handling with user-friendly network, timeout, update-data, and secure-connection messages."
                },
                {
                    "type": "improved",
                    "description": "Improved update diagnostics by separating user-facing error messages from technical error details."
                },
                {
                    "type": "improved",
                    "description": "Updated the About screen to report the current update-system status."
                },
                {
                    "type": "improved",
                    "description": "Update information can now describe Android compatibility and recommended app versions."
                }
            ]

                },
                {
                    "type": "improved",
                    "description": "Improved Last Checked information with Today, Yesterday, and dated timestamp formatting."
                },
                {
                    "type": "bug-fixed",
                    "description": "Fixed Ahead of Channel detection for development builds that are newer than every release currently listed in the update manifest."
                },
                {
                    "type": "improved",
                    "description": "Improved update channel selection so unlisted development builds can fall back to the Beta channel for update evaluation."
                },
                {
                    "type": "improved",
                    "description": "Improved updater diagnostics when an update channel does not contain valid latest-version information."
                },
                {
